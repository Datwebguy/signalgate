# Signalgate — copy to .env and fill in. Never commit .env.

# Live Telegraph node (confirm with /status before shipping)
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_ENGINE_URL=https://devnode.telegraphprotocol.com/engine
TELEGRAPH_DAEMON_URL=https://devnode.telegraphprotocol.com/daemon
TELEGRAPH_EXPLORER_URL=https://explorer.telegraphprotocol.com

# Required for paid asks. Base Sepolia USDC (eip155:84532).
# Fund this wallet with USDC at 0x036CbD53842c5426634e7929541eC2318f3dCF7e
TELEGRAPH_EVM_PRIVATE_KEY=0xYOUR_BASE_SEPOLIA_PRIVATE_KEY
EVM_NETWORK=eip155:84532

# Gate policy
GATE_MIN_CONFIDENCE=0.6
WATCHLIST_INTERVAL_MS=180000

# Start the in-process watchlist poller (Railway/Fly/Docker). Do not set on Vercel.
WATCHLIST_WORKER=0

# Vercel Cron auth for GET /api/watchlist/poll
CRON_SECRET=replace-with-a-long-random-string

# Public origin used in judge/agent snippets (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
